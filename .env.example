# ============================================
# RenVest — Variáveis de Ambiente (Fase 2)
# Copie este arquivo para ".env.local" e preencha suas chaves gratuitas
# ============================================

# 1. Supabase (https://supabase.com — Plano Gratuito)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# 2. Brapi API (https://brapi.dev — Plano Gratuito B3)
# Obs: sem token funciona para PETR4, VALE3, MGLU3 e ITUB4; com token gratuito libera toda a B3!
VITE_BRAPI_TOKEN=seu-token-brapi-aqui

# 3. Google Gemini API (https://aistudio.google.com/apikey — Free Tier)
# Para testes locais no Vite:
VITE_GEMINI_API_KEY=sua-chave-gemini-aqui
# Na Vercel (produção), cadastre também como "GEMINI_API_KEY" (sem VITE_) para manter a chave segura no backend serverless /api/gemini
